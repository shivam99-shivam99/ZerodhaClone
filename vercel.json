{
  "version": 2,
  "buildCommand": "npm --prefix dashboard install && npm --prefix dashboard run build",
  "outputDirectory": "dashboard/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
